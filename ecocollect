                <div class="p-4 rounded-2xl bg-slate-950/60 border border-eco-500/15 flex items-center justify-between gap-2">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl ${w.bg} ${w.color} flex items-center justify-center">
                            <i class="fa-solid ${w.icon}"></i>
                        </div>
                        <div>
                            <div class="font-bold text-xs text-white">${w.name}</div>
                            <div class="text-[11px] text-slate-400">Joriy: ${w.rate} ball/kg</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <input type="number" id="rate-inp-${w.id}" value="${w.rate}" min="5" class="w-16 bg-slate-900 border border-eco-500/30 rounded-lg px-2 py-1 text-xs text-white text-right">
                        <button onclick="adminUpdateRate('${w.id}')" class="px-2.5 py-1 rounded-lg bg-eco-500 text-slate-950 font-bold text-xs">Saqlash</button>
                    </div>
                </div>
            `).join('');

            // 5. Render Rewards CRUD List
            document.getElementById('admin-rewards-list').innerHTML = state.rewards.map(r => `
                <div class="p-3.5 rounded-2xl bg-slate-950/60 border border-eco-500/15 flex items-center justify-between gap-2">
                    <div>
                        <div class="font-bold text-xs text-white">${r.title}</div>
                        <div class="text-[11px] text-amber-400 font-bold">${r.cost} BALL • ${r.category}</div>
                    </div>
                    <button onclick="adminDeleteReward('${r.id}')" class="px-2.5 py-1.5 rounded-lg bg-rose-500/20 text-rose-400 hover:bg-rose-500/30 text-xs">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            `).join('');
        }

        function adminApproveTx(txId) {
            const tx = state.history.find(h => h.id === txId);
            if (!tx) return;
            tx.status = 'Tasdiqlangan';
            state.user.points += tx.points;
            state.user.xp += tx.points;
            state.user.totalKg += tx.weight;
            saveState();
            renderAll();
            showToast(`Ariza ${txId} tasdiqlandi va +${tx.points} ball foydalanuvchiga o‘tkazildi!`);
        }

        function adminRejectTx(txId) {
            const tx = state.history.find(h => h.id === txId);
            if (!tx) return;
            tx.status = 'Rad etilgan';
            saveState();
            renderAll();
            showToast(`Ariza ${txId} rad etildi.`, 'warning');
        }

        function adminAddPoint(e) {
            e.preventDefault();
            const name = document.getElementById('new-point-name').value.trim();
            const address = document.getElementById('new-point-address').value.trim();
            const hours = document.getElementById('new-point-hours').value.trim();
            const distance = document.getElementById('new-point-dist').value.trim();

            state.collectionPoints.push({
                id: 'p' + Date.now(),
                name,
                address,
                hours,
                status: 'Ochiq',
                distance,
                load: 20,
                x: Math.floor(20 + Math.random() * 60),
                y: Math.floor(20 + Math.random() * 60),
                types: ['plastik', 'qogoz', 'shisha', 'metall']
            });

            e.target.reset();
            saveState();
            renderAll();
            showToast(`Yangi "${name}" punkti xaritaga qo‘shildi!`);
        }

        function adminTogglePointStatus(pointId) {
            const p = state.collectionPoints.find(pt => pt.id === pointId);
            if (!p) return;
            const order = ['Ochiq', 'To‘lgan', 'Yopiq'];
            p.status = order[(order.indexOf(p.status) + 1) % order.length];
            saveState();
            renderAll();
            showToast(`${p.name} holati "${p.status}" ga o‘zgartirildi.`);
        }

        function adminDeletePoint(pointId) {
            state.collectionPoints = state.collectionPoints.filter(p => p.id !== pointId);
            saveState();
            renderAll();
            showToast('Topshirish punkti o‘chirildi.', 'warning');
        }

        function adminUpdateRate(wasteId) {
            const w = state.wasteTypes.find(wt => wt.id === wasteId);
            const inp = document.getElementById(`rate-inp-${wasteId}`);
            if (!w || !inp) return;
            w.rate = Math.max(1, parseInt(inp.value, 10) || w.rate);
            saveState();
            renderAll();
            showToast(`${w.name} tarifi 1 kg = ${w.rate} ball qilib yangilandi!`);
        }

        function adminAddWasteType(e) {
            e.preventDefault();
            const name = document.getElementById('new-waste-name').value.trim();
            const rate = parseInt(document.getElementById('new-waste-rate').value, 10) || 50;
            const icon = document.getElementById('new-waste-icon').value;

            state.wasteTypes.push({
                id: 'w' + Date.now(),
                name,
                rate,
                icon,
                color: 'text-eco-400',
                bg: 'bg-eco-500/20',
                totalCollected: 10
            });
            e.target.reset();
            saveState();
            renderAll();
            showToast(`"${name}" chiqindi turi (${rate} ball/kg) qo‘shildi!`);
        }

        function adminAddReward(e) {
            e.preventDefault();
            const title = document.getElementById('new-reward-title').value.trim();
            const desc = document.getElementById('new-reward-desc').value.trim();
            const cost = parseInt(document.getElementById('new-reward-cost').value, 10) || 500;
            const category = document.getElementById('new-reward-cat').value.trim();

            state.rewards.push({
                id: 'r' + Date.now(),
                title,
                desc,
                cost,
                category,
                icon: 'fa-award'
            });
            e.target.reset();
            saveState();
            renderAll();
            showToast(`Yangi "${title}" bonusi Eko-Marketga qo‘shildi!`);
        }

        function adminDeleteReward(rewardId) {
            state.rewards = state.rewards.filter(r => r.id !== rewardId);
            saveState();
            renderAll();
            showToast('Bonus Eko-Marketdan o‘chirildi.', 'warning');
        }

        function resetDemoData() {
            localStorage.removeItem(STORAGE_KEY);
            state = JSON.parse(JSON.stringify(defaultState));
            state.adminLoggedIn = true;
            saveState();
            renderAll();
            showToast('Barcha demo ma’lumotlar dastlabki holatiga tiklandi!');
        }

        // ==========================================
        // QR / PROMO CODE MODAL FUNCTIONS
        // ==========================================
        function openQrModal() {
            document.getElementById('qr-modal').classList.remove('hidden');
        }
        function closeQrModal() {
            document.getElementById('qr-modal').classList.add('hidden');
        }
        function setPromoCode(code) {
            document.getElementById('promo-code-input').value = code;
        }
        function claimPromoCode() {
            const code = (document.getElementById('promo-code-input').value || '').trim().toUpperCase();
            if (!code) {
                showToast('Iltimos, promo-kodni kiriting!', 'error');
                return;
            }
            if (state.user.usedPromos.includes(code)) {
                showToast('Bu koddan avval foydalangansiz!', 'warning');
                return;
            }

            const promoMap = {
                'YASHIL2026': 300,
                'TASHKENT-ECO': 500,
                'ECOCOLLECT': 250
            };

            const bonus = promoMap[code] || 150;
            state.user.usedPromos.push(code);
            state.user.points += bonus;
            state.user.xp += bonus;

            state.history.unshift({
                id: 'QR-' + Math.floor(100 + Math.random() * 900),
                date: 'Hozirgina',
                type: `Smart-Box Kod (${code})`,
                point: 'Smart-Terminal',
                weight: 1.5,
                points: bonus,
                status: 'Tasdiqlangan',
                isSpend: false
            });

            document.getElementById('promo-code-input').value = '';
            closeQrModal();
            saveState();
            renderAll();
            showToast(`Smart-Box kodi qabul qilindi! +${bonus} BALL qo‘shildi!`);
        }

        function renderAll() {
            renderDashboard();
            renderSubmitSection();
            renderCollectionPoints();
            renderMarket();
            renderHistory();
            renderAdmin();
        }

        // Initialize Application on Load
        window.onload = function() {
            switchTab('dashboard');
            switchAdminSubTab('approvals');
        };
    </script>
</body>
</html>
