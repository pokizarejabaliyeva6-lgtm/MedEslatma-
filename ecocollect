        function updateCalculator() {
            const waste = state.wasteTypes.find(w => w.id === state.selectedWasteId) || state.wasteTypes[0];
            const weight = Math.max(0.1, parseFloat(document.getElementById('submit-weight-input').value) || 0);
            const totalPoints = Math.round(weight * waste.rate);
            const method = document.getElementById('submit-method-select').value;

            document.getElementById('calc-total-points').textContent = `+${totalPoints.toLocaleString()}`;
            document.getElementById('calc-xp-bonus').textContent = `+${totalPoints} XP daraja uchun`;
            document.getElementById('calc-waste-name').textContent = waste.name;
            document.getElementById('calc-rate').textContent = `${waste.rate} ball / kg`;
            document.getElementById('calc-weight').textContent = `${weight} kg`;
            document.getElementById('calc-co2').textContent = `-${(weight * 1.5).toFixed(1)} kg CO₂`;

            const hint = document.getElementById('submit-mode-hint');
            if (method === 'instant') {
                hint.innerHTML = '⚡ Smart-Tarozi rejimi: Ballar darhol balansingizga qo‘shiladi.';
            } else {
                hint.innerHTML = '⏳ Operator rejimi: Ariza Admin paneliga tasdiqlash uchun yuboriladi.';
            }
        }

        function handleWasteSubmit() {
            const waste = state.wasteTypes.find(w => w.id === state.selectedWasteId) || state.wasteTypes[0];
            const weight = parseFloat(document.getElementById('submit-weight-input').value);
            if (!weight || weight <= 0) {
                showToast('Iltimos, to‘g‘ri vazn kiriting!', 'error');
                return;
            }
            const pointName = document.getElementById('submit-point-select').value;
            const method = document.getElementById('submit-method-select').value;
            const earnedPoints = Math.round(weight * waste.rate);
            const now = new Date();
            const dateStr = `${String(now.getDate()).padStart(2,'0')}.${String(now.getMonth()+1).padStart(2,'0')}.${now.getFullYear()}, ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;

            if (method === 'instant') {
                state.user.points += earnedPoints;
                state.user.xp += earnedPoints;
                state.user.totalKg += weight;
                waste.totalCollected += weight;

                state.history.unshift({
                    id: 'TX-' + Math.floor(1000 + Math.random() * 9000),
                    date: dateStr,
                    type: waste.name,
                    point: pointName,
                    weight: weight,
                    points: earnedPoints,
                    status: 'Tasdiqlangan',
                    isSpend: false,
                    user: state.user.name
                });
                showToast(`Barakalla! ${weight} kg ${waste.name} uchun +${earnedPoints} BALL hisobingizga o‘tkazildi!`);
            } else {
                state.history.unshift({
                    id: 'TX-' + Math.floor(1000 + Math.random() * 9000),
                    date: dateStr,
                    type: waste.name,
                    point: pointName,
                    weight: weight,
                    points: earnedPoints,
                    status: 'Kutilmoqda',
                    isSpend: false,
                    user: state.user.name
                });
                showToast(`Arizangiz qabul qilindi! Admin tasdiqlagach +${earnedPoints} ball beriladi.`, 'warning');
            }

            document.getElementById('submit-note').value = '';
            saveState();
            renderAll();
        }

