<!DOCTYPE html>
<html lang="uz" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EcoCollect — Chiqindini topshirishni rag‘batlantirish platformasi</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        eco: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            200: '#a7f3d0',
                            300: '#6ee7b7',
                            400: '#34d399',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                            950: '#022c22',
                        }
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'shimmer': 'shimmer 2.5s linear infinite',
                        'pop': 'pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        shimmer: {
                            '0%': { backgroundPosition: '-200% 0' },
                            '100%': { backgroundPosition: '200% 0' },
                        },
                        pop: {
                            '0%': { transform: 'scale(0.9)', opacity: '0' },
                            '100%': { transform: 'scale(1)', opacity: '1' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Glassmorphism & Scrollbars */
        body {
            background-color: #04130e;
            color: #ecfdf5;
            overflow-x: hidden;
        }
        .glass-card {
            background: rgba(6, 45, 33, 0.55);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(52, 211, 153, 0.16);
        }
        .glass-card-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-card-hover:hover {
            transform: translateY(-4px);
            border-color: rgba(52, 211, 153, 0.45);
            box-shadow: 0 12px 30px -10px rgba(16, 185, 129, 0.25);
        }
        .eco-gradient {
            background: linear-gradient(135deg, #10b981 0%, #059669 50%, #047857 100%);
        }
        .gold-gradient {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
        }
        /* Animated background orbs */
        .bg-orb-1 {
            position: fixed;
            top: -10%;
            left: -10%;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(16,185,129,0.15) 0%, rgba(0,0,0,0) 70%);
            z-index: -1;
            pointer-events: none;
        }
        .bg-orb-2 {
            position: fixed;
            bottom: -15%;
            right: -10%;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(52,211,153,0.12) 0%, rgba(0,0,0,0) 70%);
            z-index: -1;
            pointer-events: none;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #022c22;
        }
        ::-webkit-scrollbar-thumb {
            background: #065f46;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #10b981;
        }
        /* Map Pattern Background */
        .map-grid {
            background-color: #031c14;
            background-image: 
                linear-gradient(rgba(16, 185, 129, 0.07) 1px, transparent 1px),
                linear-gradient(90deg, rgba(16, 185, 129, 0.07) 1px, transparent 1px);
            background-size: 32px 32px;
        }
        .pulse-ring {
            animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.8; }
            80%, 100% { transform: scale(2.2); opacity: 0; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col lg:flex-row selection:bg-eco-500 selection:text-white">

    <!-- Background Orbs -->
    <div class="bg-orb-1"></div>
    <div class="bg-orb-2"></div>

    <!-- TOAST NOTIFICATIONS CONTAINER -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- DESKTOP SIDEBAR -->
    <aside class="hidden lg:flex flex-col w-72 glass-card border-r border-eco-500/20 fixed h-full z-30 justify-between p-6">
        <div>
            <!-- Brand Logo -->
            <div class="flex items-center gap-3 mb-8 cursor-pointer" onclick="switchTab('dashboard')">
                <div class="w-11 h-11 rounded-2xl eco-gradient flex items-center justify-center shadow-lg shadow-eco-500/30 animate-float">
                    <i class="fa-solid fa-leaf text-white text-xl"></i>
                </div>
                <div>
                    <span class="font-display font-extrabold text-2xl tracking-tight text-white">Eco<span class="text-eco-400">Collect</span></span>
                    <span class="block text-[11px] text-eco-300/80 uppercase tracking-widest font-semibold">GreenTech & Bonus</span>
                </div>
            </div>

            <!-- User Mini Status Card -->
            <div class="p-4 rounded-2xl bg-eco-900/60 border border-eco-500/20 mb-6 relative overflow-hidden">
                <div class="flex items-center gap-3 mb-3">
                    <div class="relative">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-eco-600 to-teal-400 flex items-center justify-center text-white font-bold text-lg shadow-md">
                            S
                        </div>
                        <span id="sidebar-level-badge" class="absolute -bottom-1 -right-1 bg-amber-500 text-slate-950 text-[10px] font-extrabold px-1.5 py-0.5 rounded-full border border-slate-900">
                            LVL 4
                        </span>
                    </div>
                    <div class="overflow-hidden">
                        <h4 class="font-bold text-white text-sm truncate">Sardorbek Aliyev</h4>
                        <p id="sidebar-rank-title" class="text-xs text-eco-300 font-medium">Yashil Qahramon</p>
                    </div>
                </div>
                <!-- Mini Balance -->
                <div class="flex items-center justify-between bg-slate-950/50 rounded-xl px-3 py-2 border border-eco-500/10">
                    <span class="text-xs text-slate-300">Eko-Balans:</span>
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-coins text-amber-400 text-sm"></i>
                        <span id="sidebar-points" class="font-display font-bold text-white text-sm">2,450</span>
                        <span class="text-[10px] text-amber-400 font-semibold">BALL</span>
                    </div>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="space-y-1.5" id="desktop-nav">
                <button onclick="switchTab('dashboard')" data-tab="dashboard" class="nav-btn w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-medium transition-all">
                    <i class="fa-solid fa-chart-pie w-5 text-center"></i>
                    <span>Asosiy Panel</span>
                </button>
                <button onclick="switchTab('submit')" data-tab="submit" class="nav-btn w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-medium transition-all">
                    <i class="fa-solid fa-recycle w-5 text-center"></i>
                    <span>Chiqindi Topshirish</span>
                    <span class="ml-auto bg-eco-500/20 text-eco-300 text-[10px] font-bold px-2 py-0.5 rounded-full border border-eco-500/30">+Ball</span>
                </button>
                <button onclick="switchTab('points')" data-tab="points" class="nav-btn w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-medium transition-all">
                    <i class="fa-solid fa-map-location-dot w-5 text-center"></i>
                    <span>Topshirish Punktlari</span>
                </button>
                <button onclick="switchTab('market')" data-tab="market" class="nav-btn w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-medium transition-all">
                    <i class="fa-solid fa-gift w-5 text-center"></i>
                    <span>Bonus va Eko-Market</span>
                </button>
                <button onclick="switchTab('history')" data-tab="history" class="nav-btn w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-medium transition-all">
                    <i class="fa-solid fa-clock-rotate-left w-5 text-center"></i>
                    <span>Topshirish Tarixi</span>
                </button>
                <div class="pt-3 mt-3 border-t border-eco-500/15">
                    <button onclick="switchTab('admin')" data-tab="admin" class="nav-btn w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-medium transition-all">
                        <i class="fa-solid fa-shield-halved w-5 text-center text-amber-400"></i>
                        <span>Admin Boshqaruv</span>
                        <span id="admin-pending-badge" class="ml-auto bg-amber-500 text-slate-950 text-[10px] font-extrabold px-2 py-0.5 rounded-full">2</span>
                    </button>
                </div>
            </nav>
        </div>

        <!-- Daily Eco Quote / Footer -->
        <div class="p-4 rounded-2xl bg-gradient-to-br from-eco-900/80 to-slate-900/90 border border-eco-500/20">
            <div class="flex items-center gap-2 text-eco-400 text-xs font-bold mb-1">
                <i class="fa-solid fa-seedling"></i>
                <span>Eko-Eslatma</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
                1 tonna qayta ishlangan plastik 16.3 barrel neftni va 5,774 kVt/soat elektr energiyasini tejaydi!
            </p>
        </div>
    </aside>

    <!-- MOBILE HEADER -->
    <header class="lg:hidden sticky top-0 z-30 glass-card border-b border-eco-500/20 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2.5" onclick="switchTab('dashboard')">
            <div class="w-9 h-9 rounded-xl eco-gradient flex items-center justify-center shadow-md">
                <i class="fa-solid fa-leaf text-white"></i>
            </div>
            <div>
                <span class="font-display font-extrabold text-lg text-white">Eco<span class="text-eco-400">Collect</span></span>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <!-- Mobile Points Pill -->
            <div onclick="switchTab('market')" class="flex items-center gap-1.5 bg-eco-950/90 border border-amber-500/30 px-3 py-1.5 rounded-full cursor-pointer">
                <i class="fa-solid fa-coins text-amber-400 text-xs"></i>
                <span id="mobile-points" class="font-display font-bold text-white text-xs">2,450</span>
            </div>
            <!-- Admin Shortcut Mobile -->
            <button onclick="switchTab('admin')" class="relative w-9 h-9 rounded-xl bg-eco-900/70 border border-eco-500/30 flex items-center justify-center text-amber-400">
                <i class="fa-solid fa-shield-halved text-sm"></i>
                <span id="mobile-admin-badge" class="absolute -top-1 -right-1 bg-amber-500 text-slate-950 text-[9px] font-extrabold w-4 h-4 rounded-full flex items-center justify-center">2</span>
            </button>
        </div>
    </header>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 lg:ml-72 p-4 sm:p-6 lg:p-8 pb-24 lg:pb-12 max-w-7xl w-full mx-auto">

        <!-- TOP BAR (Desktop Quick Actions & Promo Code) -->
        <div class="hidden sm:flex items-center justify-between mb-8 glass-card px-6 py-4 rounded-2xl">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2 text-sm text-eco-200">
                    <span class="w-2.5 h-2.5 rounded-full bg-eco-400 animate-ping"></span>
                    <span class="font-medium">Toshkent bo‘yicha <strong id="top-active-points" class="text-white">6 ta</strong> eko-punkt faol ishlamoqda</span>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="openQrModal()" class="flex items-center gap-2 bg-eco-900/80 hover:bg-eco-800 text-eco-200 border border-eco-500/30 px-4 py-2 rounded-xl text-xs font-semibold transition-all">
                    <i class="fa-solid fa-qrcode text-eco-400"></i>
                    <span>Smart-Box Kod kiritish</span>
                </button>
                <button onclick="switchTab('submit')" class="flex items-center gap-2 eco-gradient hover:opacity-95 text-white px-4 py-2 rounded-xl text-xs font-bold shadow-lg shadow-eco-600/30 transition-all">
                    <i class="fa-solid fa-plus"></i>
                    <span>Chiqindi topshirish</span>
                </button>
            </div>
        </div>

        <!-- ==========================================
             TAB 1: FOYDALANUVCHI DASHBOARD (ASOSIY)
             ========================================== -->
        <section id="tab-dashboard" class="tab-section space-y-6 animate-pop">
            
            <!-- Hero Gamification Banner -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Level & XP Card (2 cols) -->
                <div class="lg:col-span-2 glass-card rounded-3xl p-6 sm:p-8 relative overflow-hidden flex flex-col justify-between">
                    <div class="absolute -right-12 -bottom-12 opacity-10 pointer-events-none">
                        <i class="fa-solid fa-earth-asia text-[220px] text-eco-400"></i>
                    </div>
                    
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                        <div>
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-eco-500/20 border border-eco-400/30 text-eco-300 text-xs font-bold mb-2">
                                <i class="fa-solid fa-fire text-amber-400"></i>
                                <span>5 kunlik uzluksiz faollik (Streak!)</span>
                            </div>
                            <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-white">
                                Xush kelibsiz, <span class="text-transparent bg-clip-text bg-gradient-to-r from-eco-300 to-amber-300">Sardorbek!</span>
                            </h1>
                            <p class="text-sm text-slate-300 mt-1">Tabiatni asrashdagi hissangiz uchun rahmat. Keyingi darajaga oz qoldi!</p>
                        </div>
                        <div class="flex items-center gap-3 bg-slate-950/60 p-3.5 rounded-2xl border border-eco-500/20 shrink-0">
                            <div class="w-12 h-12 rounded-xl gold-gradient flex items-center justify-center text-slate-950 text-xl font-black shadow-lg">
                                <i class="fa-solid fa-trophy"></i>
                            </div>
                            <div>
                                <div class="text-xs text-slate-400">Joriy maqomingiz</div>
                                <div id="dash-level-title" class="font-display font-bold text-white text-base">Yashil Qahramon</div>
                                <div id="dash-level-num" class="text-xs text-amber-400 font-bold">Level 4 • 2,450 XP</div>
                            </div>
                        </div>
                    </div>

                    <!-- XP Progress Bar -->
                    <div class="bg-slate-950/50 p-4 rounded-2xl border border-eco-500/15">
                        <div class="flex justify-between text-xs font-semibold mb-2">
                            <span class="text-eco-300">Level 4 progressi</span>
                            <span id="xp-progress-text" class="text-white">2,450 / 3,000 XP (82%)</span>
                        </div>
                        <div class="w-full h-3.5 bg-slate-800 rounded-full overflow-hidden p-0.5">
                            <div id="xp-progress-bar" class="h-full rounded-full bg-gradient-to-r from-eco-500 via-teal-400 to-amber-400 transition-all duration-700" style="width: 82%"></div>
                        </div>
                        <div class="flex justify-between items-center mt-2.5 text-[11px] text-slate-400">
                            <span>Keyingi maqom: <strong class="text-eco-300">Eko-Elchi (Level 5)</strong></span>
                            <button onclick="openQrModal()" class="text-amber-400 hover:underline font-semibold sm:hidden">
                                <i class="fa-solid fa-qrcode mr-1"></i>Kod kiritish
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Quick Wallet / Balance Card -->
                <div class="glass-card rounded-3xl p-6 flex flex-col justify-between bg-gradient-to-b from-eco-900/60 to-slate-950/80 border border-amber-500/25">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="text-xs uppercase tracking-wider font-bold text-amber-300/90">Mening Eko-Hamyonim</span>
                            <span class="w-8 h-8 rounded-lg bg-amber-500/20 flex items-center justify-center text-amber-400">
                                <i class="fa-solid fa-wallet"></i>
                            </span>
                        </div>
                        <div class="flex items-baseline gap-2 my-2">
                            <span id="dash-points" class="font-display text-4xl sm:text-5xl font-extrabold text-white">2,450</span>
                            <span class="text-amber-400 font-bold text-sm">EKO-BALL</span>
                        </div>
                        <p class="text-xs text-slate-300">
                            Taxminiy qiymati: <strong id="dash-uzs-value" class="text-eco-300">24,500 so‘m</strong> vaucher va xizmatlar
                        </p>
                    </div>

                    <div class="grid grid-cols-2 gap-2.5 mt-6">
                        <button onclick="switchTab('submit')" class="eco-gradient hover:opacity-95 text-white py-3 px-3 rounded-xl font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-eco-600/25 transition-all">
                            <i class="fa-solid fa-recycle"></i>
                            <span>Ball yig‘ish</span>
                        </button>
                        <button onclick="switchTab('market')" class="bg-amber-500 hover:bg-amber-400 text-slate-950 py-3 px-3 rounded-xl font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 transition-all">
                            <i class="fa-solid fa-gift"></i>
                            <span>Almashtirish</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 4 KPI Impact Stats -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="glass-card glass-card-hover p-5 rounded-2xl">
                    <div class="w-10 h-10 rounded-xl bg-eco-500/20 text-eco-400 flex items-center justify-center text-lg mb-3">
                        <i class="fa-solid fa-weight-scale"></i>
                    </div>
                    <div class="text-xs text-slate-400">Topshirilgan chiqindi</div>
                    <div class="font-display text-2xl font-extrabold text-white mt-0.5"><span id="stat-total-kg">48.5</span> <span class="text-sm font-normal text-eco-400">kg</span></div>
                </div>

                <div class="glass-card glass-card-hover p-5 rounded-2xl">
                    <div class="w-10 h-10 rounded-xl bg-teal-500/20 text-teal-400 flex items-center justify-center text-lg mb-3">
                        <i class="fa-solid fa-cloud-sun"></i>
                    </div>
                    <div class="text-xs text-slate-400">Saqlab qolingan CO₂</div>
                    <div class="font-display text-2xl font-extrabold text-white mt-0.5"><span id="stat-co2">72.8</span> <span class="text-sm font-normal text-teal-400">kg</span></div>
                </div>

                <div class="glass-card glass-card-hover p-5 rounded-2xl">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-lg mb-3">
                        <i class="fa-solid fa-tree"></i>
                    </div>
                    <div class="text-xs text-slate-400">Asrab qolingan daraxtlar</div>
                    <div class="font-display text-2xl font-extrabold text-white mt-0.5"><span id="stat-trees">4</span> <span class="text-sm font-normal text-amber-400">tup</span></div>
                </div>

                <div class="glass-card glass-card-hover p-5 rounded-2xl">
                    <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center text-lg mb-3">
                        <i class="fa-solid fa-check-double"></i>
                    </div>
                    <div class="text-xs text-slate-400">Tasdiqlangan topshirishlar</div>
                    <div class="font-display text-2xl font-extrabold text-white mt-0.5"><span id="stat-tx-count">12</span> <span class="text-sm font-normal text-purple-400">marta</span></div>
                </div>
            </div>

            <!-- Eco-Challenges & Leaderboard Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Eco-Missiyalar (Challenges) -->
                <div class="lg:col-span-2 glass-card rounded-3xl p-6">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <h2 class="font-display text-lg font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-bolt text-amber-400"></i>
                                <span>Haftalik Eko-Missiyalar</span>
                            </h2>
                            <p class="text-xs text-slate-400">Vazifalarni bajaring va qo‘shimcha bonus ballarga ega bo‘ling</p>
                        </div>
                        <span class="text-xs bg-eco-500/20 text-eco-300 px-3 py-1 rounded-full font-semibold">Yangilanish: 3 kun</span>
                    </div>

                    <div id="challenges-container" class="space-y-3.5">
                        <!-- Dynamically populated via JS -->
                    </div>
                </div>

                <!-- Peshqadamlar Jadvali (Leaderboard) -->
                <div class="glass-card rounded-3xl p-6 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-5">
                            <h2 class="font-display text-lg font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-crown text-amber-400"></i>
                                <span>Top Eko-Faollar</span>
                            </h2>
                            <span class="text-[11px] text-eco-400 font-semibold">Toshkent sh.</span>
                        </div>

                        <div id="leaderboard-container" class="space-y-2.5">
                            <!-- Dynamically populated via JS -->
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-eco-500/15 text-center">
                        <p class="text-xs text-slate-400">Oy yakunida TOP-3 ishtirokchiga <strong class="text-amber-300">5,000 ball</strong> sovg‘a qilinadi!</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================
             TAB 2: CHIQINDI TOPSHIRISH VA KALKULYATOR
             ========================================== -->
        <section id="tab-submit" class="tab-section hidden space-y-6 animate-pop">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-white">Chiqindi Topshirish va Ball Kalkulyatori</h1>
                    <p class="text-sm text-slate-300">Chiqindi turini tanlang, vaznini kiriting va darhol ballarga ega bo‘ling</p>
