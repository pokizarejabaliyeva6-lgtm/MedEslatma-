        // Level Calculation Helper
        function getLevelInfo(xp) {
            const level = Math.floor(xp / 600) + 1;
            const titles = ['Eko-Boshlovchi', 'Tabiat Do‘sti', 'Qayta Ishlash Ustasi', 'Yashil Qahramon', 'Eko-Elchi', 'Sayyora Himoyachisi'];
            const title = titles[Math.min(level - 1, titles.length - 1)];
            const nextLevelXp = level * 600;
            const prevLevelXp = (level - 1) * 600;
            const progress = Math.min(100, Math.round(((xp - prevLevelXp) / (nextLevelXp - prevLevelXp)) * 100));
            return { level, title, nextLevelXp, progress };
        }

