            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const colors = {
                success: 'border-eco-400 bg-eco-950/95 text-eco-100',
                warning: 'border-amber-400 bg-slate-900/95 text-amber-100',
                error: 'border-rose-500 bg-rose-950/95 text-rose-100'
            };
            const icons = {
                success: 'fa-circle-check text-eco-400',
                warning: 'fa-triangle-exclamation text-amber-400',
                error: 'fa-circle-xmark text-rose-400'
            };
            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3.5 rounded-2xl border shadow-2xl animate-pop ${colors[type] || colors.success}`;
            toast.innerHTML = `
                <i class="fa-solid ${icons[type] || icons.success} text-lg"></i>
                <div class="text-xs font-semibold leading-snug">${message}</div>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
